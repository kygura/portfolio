# ─── Notion → blog pipeline ────────────────────────────────────────────────
# Posts are pulled from Notion at build time (scripts/build-writings.ts) and
# shipped as static files. Notion events only trigger a rebuild.

# Notion integration token. Without it the build uses the committed snapshot
# in content/writings/.
NOTION_SECRET=ntn_xxx

# The Publications data source (preferred) or database. Also used by the
# webhook to ignore page events from other databases.
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_ID=

# Vercel deploy hook (Project → Settings → Git → Deploy Hooks, branch: main).
# The webhook and the rebuild endpoint POST here.
VERCEL_DEPLOY_HOOK_URL=

# HMAC key used to verify the X-Notion-Signature header. Notion sends this once
# during the subscription handshake; it is logged by POST /api/notion.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Set to "true" to reject unsigned/invalid webhook calls.
NOTION_WEBHOOK_REQUIRE_SIGNATURE=

# Bearer secret for manual rebuilds: POST /api/notion/sync.
NOTION_SYNC_TRIGGER_SECRET=
# Vercel sends this as a bearer token to the daily safety-net cron.
CRON_SECRET=

# Absolute site URL for links in /llms.txt and /writings.json. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL on Vercel.
SITE_URL=

# ─── Software page (/projects) ─────────────────────────────────────────────
# GitHub account and optional token (needed for private repos).
GITHUB_USER=kygura
GITHUB_TOKEN=

# Which repos may appear. Names, separated by commas or spaces; case and an
# "owner/" prefix are ignored. Keep these in Vercel's env, not in git, so the
# names stay private. The "portfolio-hide" topic on a repo also hides it.
#   SHOWCASE_INCLUDE: when set, ONLY these repos appear (allowlist).
#   SHOWCASE_EXCLUDE: these never appear, even if included.
SHOWCASE_INCLUDE=
SHOWCASE_EXCLUDE=

# Haiku card descriptions, generated terminal sessions on code-only cards, and
# Wick's lines (/api/companion; without it he falls back to a few of his own).
ANTHROPIC_API_KEY=
