# ─── Notion → blog pipeline ────────────────────────────────────────────────
# Posts are pulled from Notion at build time (scripts/build-writings.ts) and
# shipped as static files. Notion events only trigger a rebuild.

# Notion integration token. Without it the build uses the committed snapshot
# in content/writings/.
NOTION_SECRET=ntn_xxx

# The Publications data source (preferred) or database. Also used by the
# webhook to ignore page events from other databases.
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_ID=

# Vercel deploy hook (Project → Settings → Git → Deploy Hooks, branch: main).
# The webhook and the rebuild endpoint POST here.
VERCEL_DEPLOY_HOOK_URL=

# HMAC key used to verify the X-Notion-Signature header. Notion sends this once
# during the subscription handshake; it is logged by POST /api/notion.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Set to "true" to reject unsigned/invalid webhook calls.
NOTION_WEBHOOK_REQUIRE_SIGNATURE=

# Bearer secret for manual rebuilds: POST /api/notion/sync.
NOTION_SYNC_TRIGGER_SECRET=
# Vercel sends this as a bearer token to the daily safety-net cron.
CRON_SECRET=

# Absolute site URL for links in /llms.txt and /writings.json. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL on Vercel.
SITE_URL=

# ─── Software page (/projects) ─────────────────────────────────────────────
# GitHub account and optional token (needed for private repos).
GITHUB_USER=kygura
GITHUB_TOKEN=

# Which repos may appear. Public repos show by default. Names, separated by
# commas or spaces; case and an "owner/" prefix are ignored. Keep these in
# Vercel's env, not in git, so the names stay private. The "portfolio-hide"
# topic on a repo also hides it.
#   SHOWCASE_INCLUDE: private repos to show even without a live site (needs
#                     GITHUB_TOKEN). Private repos with a site show anyway.
#   SHOWCASE_EXCLUDE: these never appear (blocklist), even if included.
SHOWCASE_INCLUDE=
SHOWCASE_EXCLUDE=

# Haiku card descriptions and the "talk to the codebase" chat on /projects/<repo>.
ANTHROPIC_API_KEY=

# ─── Plot (/plot) ──────────────────────────────────────────────────────────
# Upstash Redis REST credentials for the shared pixel sheet. Adding Upstash
# from the Vercel marketplace sets these. Either pair works. Without them the
# page keeps a sheet in the visitor's browser only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resident agents on /plot need ANTHROPIC_API_KEY (above). Viewers' polls drive
# their turns: at most one turn every 15 s across all visitors, none when
# nobody is watching. Daily cap on turns (default 240; 0 stops them), or set
# PLOT_AGENTS=off to switch them off entirely.
PLOT_AGENT_DAILY_TURNS=
PLOT_AGENTS=
