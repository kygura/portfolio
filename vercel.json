{
  "buildCommand": "bun run build",
  "ignoreCommand": "node --experimental-strip-types scripts/should-build.ts",
  "functions": {
    "api/github/codebase.ts": {
      "maxDuration": 300
    },
    "api/writings/translate.ts": {
      "maxDuration": 300,
      "includeFiles": "content/{writings,translations}/**/*.md"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?kygra\\.xyz"
        }
      ],
      "destination": "https://www.nca.ink/$1",
      "permanent": true
    },
    {
      "source": "/writings/the-movement-of-the-world",
      "destination": "/writings/on-the-movements-of-the-world",
      "permanent": true
    },
    {
      "source": "/writings/a-philosophy-of-pragmatic-sovereignity",
      "destination": "/writings/the-unsigned-contract",
      "permanent": true
    },
    {
      "source": "/writings/the-last-sovereign-act",
      "destination": "/writings/the-unsigned-contract",
      "permanent": true
    },
    {
      "source": "/writings/the-last-sovereign-act.md",
      "destination": "/writings/the-unsigned-contract.md",
      "permanent": true
    },
    {
      "source": "/writings/the-soul-as-a-system-prompt",
      "destination": "/writings/the-wrapper-and-the-soul",
      "permanent": true
    },
    {
      "source": "/writings/the-soul-as-a-system-prompt.md",
      "destination": "/writings/the-wrapper-and-the-soul.md",
      "permanent": true
    },
    {
      "source": "/writings/the-language-game",
      "destination": "/writings/the-projection-loop",
      "permanent": true
    },
    {
      "source": "/writings/the-language-game.md",
      "destination": "/writings/the-projection-loop.md",
      "permanent": true
    },
    {
      "source": "/writings/the-game-of-democracy",
      "destination": "/writings/the-design-question",
      "permanent": true
    },
    {
      "source": "/writings/the-game-of-democracy.md",
      "destination": "/writings/the-design-question.md",
      "permanent": true
    },
    {
      "source": "/writings/always-against",
      "destination": "/writings/perpetua-libertas",
      "permanent": true
    },
    {
      "source": "/writings/always-against.md",
      "destination": "/writings/perpetua-libertas.md",
      "permanent": true
    },
    {
      "source": "/writings/corposlop",
      "destination": "/writings/a-mind-you-can-locate",
      "permanent": true
    },
    {
      "source": "/writings/corposlop.md",
      "destination": "/writings/a-mind-you-can-locate.md",
      "permanent": true
    },
    {
      "source": "/writings/intellectual-opium",
      "destination": "/writings/the-inversion",
      "permanent": true
    },
    {
      "source": "/writings/intellectual-opium.md",
      "destination": "/writings/the-inversion.md",
      "permanent": true
    },
    {
      "source": "/writings/the-perpetual-i",
      "destination": "/writings/the-illusion-of-freedom",
      "permanent": false
    },
    {
      "source": "/writings/the-perpetual-i.md",
      "destination": "/writings/the-illusion-of-freedom.md",
      "permanent": false
    },
    {
      "source": "/writings/monk-mode",
      "destination": "/writings/to-seek-higher-things",
      "permanent": false
    },
    {
      "source": "/writings/monk-mode.md",
      "destination": "/writings/to-seek-higher-things.md",
      "permanent": false
    },
    {
      "source": "/writings/what-cant-be-counted",
      "destination": "/writings",
      "permanent": false
    },
    {
      "source": "/writings/what-cant-be-counted.md",
      "destination": "/writings",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/notion",
      "destination": "/api/notion/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/cv",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/cv.md"
    },
    {
      "source": "/cv",
      "destination": "/cv.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notion/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
